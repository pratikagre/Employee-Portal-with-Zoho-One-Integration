# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=zoho_portal_jwt_secret_key_production_grade_super_secure_2026
JWT_EXPIRES_IN=24h

# Database Configuration (Relational SQLite)
DB_PATH=./data/portal.db

# Zoho One API Credentials (Single Backend Service Account)
# Leave blank to use built-in rich simulation mode for demo/evaluation
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_ORG_ID=

# Simulation Mode: 'auto' will use live Zoho APIs if credentials are provided,
# or fallback gracefully to high-fidelity mock data if credentials are empty.
ZOHO_SIMULATION_MODE=auto
